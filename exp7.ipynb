import pandas as pd


# ============================================================
# 1. Load Student Performance Dataset
# ============================================================

df = pd.read_csv("student_data.csv")

# Display first five records
print("Student Performance Dataset")
print(df.head())


# ============================================================
# 2. Average Student Performance by Age
# ============================================================

age_summary = df.groupby("age")[["G1", "G2", "G3"]].mean()

print("\nAverage Student Performance by Age")
print(age_summary)


# ============================================================
# 3. Create Date Column
# ============================================================

# Create an artificial daily date range for time-series analysis.
# Note: These dates are not actual student dates.
df["Date"] = pd.date_range(
    start="2024-01-01",
    periods=len(df),
    freq="D"
)

# Set Date as the index
df.set_index("Date", inplace=True)


# ============================================================
# 4. Down-Sampling: Daily to Monthly
# ============================================================

monthly_data = df.resample("ME").mean(numeric_only=True)

print("\nDown-Sampled Monthly Data")
print(monthly_data)


# ============================================================
# 5. Up-Sampling: Monthly to Daily
# ============================================================

daily_data = monthly_data.resample("D").ffill()

print("\nUp-Sampled Daily Data")
print(daily_data.head(15))


# ============================================================
# 6. Save Results
# ============================================================

age_summary.to_csv("average_performance_by_age.csv")
monthly_data.to_csv("monthly_student_data.csv")
daily_data.to_csv("daily_student_data.csv")

print("\nAnalysis completed successfully.")
print("Output files saved:")
print("- average_performance_by_age.csv")
print("- monthly_student_data.csv")
print("- daily_student_data.csv")


