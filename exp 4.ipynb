# Equal-Width Binning
df["Age_EqualWidth"] = pd.cut(
    df["age"],
    bins=4,
    labels=["Young", "Adult", "Middle Age", "Older"]
)

# Equal-Frequency Binning
df["Age_EqualFrequency"] = pd.qcut(
    df["age"],
    q=4,
    labels=["Young", "Adult", "Middle Age", "Older"]
)

# Display results
print(df[[
    "age",
    "Age_EqualWidth",
    "Age_EqualFrequency"
]])

